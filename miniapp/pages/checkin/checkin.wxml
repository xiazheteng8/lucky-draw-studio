<view class="theme-wrapper {{ themeClass }}">
  <block wx:if="{{ !id }}">
    <!-- 场景A：未扫码直接打开小程序时的引导与扫码入口 -->
    <view class="campaign-header">
      <image class="activity-logo" src="{{ defaultAvatar }}" mode="aspectFill" />
      <view class="badge">瞎折腾摇奖吧</view>
      <view class="campaign-title">现场扫码签到</view>
      <view class="count-tag">大屏互动 · 实时抽奖</view>
    </view>

    <view class="card empty-card">
      <view class="empty-icon">📷</view>
      <view class="empty-title">扫码加入大屏活动</view>
      <view class="empty-tip">请使用手机微信扫描现场大屏上的活动二维码直接进入，或者点击下方按钮快速扫码：</view>
      <button class="btn-primary scan-btn" bindtap="scanScreenCode">
        📷 扫描大屏签到码
      </button>
    </view>
  </block>

  <block wx:else>
    <!-- 场景B：扫码后直接进入活动主页面 -->
    <view class="campaign-header">
      <!-- 活动图标：默认瞎折腾Logo，扫码识别后换成活动自定义图标 -->
      <image class="activity-logo" src="{{ activityLogo }}" mode="aspectFill" />
      <view class="badge">{{ campaign.open ? '● 现场进行中' : '● 报名已截止' }}</view>
      <view class="campaign-title">{{ campaign.title || '载入活动中...' }}</view>
      <view class="count-tag">大屏已汇聚 {{ campaign.checkinCount || 0 }} 位参与者</view>
    </view>

    <!-- 微信自动识别身份区（直接自动识别，无手动输入框，无需手动点击） -->
    <view class="card user-badge-card">
      <view class="user-badge-inner">
        <image class="user-avatar-img" src="{{ avatarUrl || defaultAvatar }}" mode="aspectFill" />
        <view class="user-badge-info">
          <view class="user-name-row">
            <text class="user-name-text">{{ nickName }}</text>
            <text class="user-check-icon">✓ 已自动识别</text>
          </view>
          <view class="user-status-desc">{{ checkedIn ? '已成功登上大屏 · 拥有抽奖资格' : '正在自动载入抽奖资格...' }}</view>
        </view>
      </view>
    </view>

    <!-- 现场互动留言 / 祝福评论区 -->
    <view class="card interactive-card">
      <view class="section-title-row">
        <text class="section-title">现场留言 · 祝福评论</text>
        <text class="section-sub">发往现场大屏幕</text>
      </view>

      <!-- 快速祝福快捷标签 -->
      <view class="quick-tags">
        <text class="tag-item" bindtap="fillQuickTag" data-text="新春大吉，大展宏图！">🧨 新春大吉</text>
        <text class="tag-item" bindtap="fillQuickTag" data-text="恭喜发财，好运连连！">💰 恭喜发财</text>
        <text class="tag-item" bindtap="fillQuickTag" data-text="今晚锦鲤必是我！">🎉 锦鲤附体</text>
        <text class="tag-item" bindtap="fillQuickTag" data-text="迎春接福发大财！">🧧 财运亨通</text>
      </view>

      <textarea class="blessing-textarea" placeholder="写一句祝福、留言或弹幕，发往现场大屏幕..." value="{{ blessing }}" bindinput="onBlessingInput" maxlength="100" />

      <!-- 底部互动操作：送爱心与发送留言 -->
      <view class="action-footer">
        <button class="heart-btn {{ heartPulsing ? 'pulse' : '' }}" bindtap="tapHeart">
          <text class="heart-icon">♥</text> 送爱心 <text class="likes-badge">{{ likesCount }}</text>
        </button>
        <button class="btn-primary send-msg-btn" loading="{{ submitting }}" bindtap="sendBlessingMessage">
          🚀 发送留言上大屏
        </button>
      </view>
    </view>

    <!-- 中奖与开奖状态实时提示卡片 -->
    <view wx:if="{{ campaign.isDrawn }}" class="card result-card {{ isWinner ? 'winner-box' : '' }}">
      <view wx:if="{{ isWinner }}" class="winner-inner">
        <view class="trophy-icon">🏆</view>
        <view class="winner-title">恭喜您中奖啦！</view>
        <view class="prize-tag">{{ winnerPrize || '中奖幸运儿' }}</view>
        <view class="winner-tip">请关注现场大屏幕并联系工作人员领奖</view>
      </view>
      <view wx:else class="not-winner-inner">
        <view class="lottery-done-title">本轮抽奖已揭晓</view>
        <view class="lottery-done-tip">感谢您的热情参与，送上真挚祝福！</view>
      </view>
    </view>
  </block>
</view>
