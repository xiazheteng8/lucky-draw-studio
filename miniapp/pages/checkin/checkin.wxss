.campaign-header {
  margin: 10rpx 0 24rpx 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.activity-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid var(--accent, #6ae3ef);
  box-shadow: 0 0 24rpx rgba(0, 0, 0, 0.4);
  margin-bottom: 14rpx;
  background: rgba(0, 0, 0, 0.2);
}

.badge {
  display: inline-block;
  font-size: 22rpx;
  color: var(--accent, #6ae3ef);
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid var(--accent, #6ae3ef);
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.campaign-title {
  font-size: 38rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.count-tag {
  display: inline-block;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.08);
  color: var(--gold, #ffd700);
  border: 1px solid var(--gold, #ffd700);
}

/* 微信自动识别身份卡片 */
.user-badge-card {
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  background: var(--card-bg, rgba(16, 34, 53, 0.75));
  border: 1px solid var(--card-border, #31566c);
  border-radius: 20rpx;
}

.user-badge-inner {
  display: flex;
  align-items: center;
}

.user-avatar-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx solid var(--accent, #6ae3ef);
  margin-right: 22rpx;
  flex-shrink: 0;
  background: rgba(0, 0, 0, 0.2);
}

.user-badge-info {
  flex: 1;
  overflow: hidden;
}

.user-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.user-name-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
  margin-right: 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-check-icon {
  font-size: 20rpx;
  color: #10b981;
  background: rgba(16, 185, 129, 0.15);
  border: 1px solid #10b981;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.user-status-desc {
  font-size: 22rpx;
  opacity: 0.8;
  color: var(--gold, #ffd700);
}

/* 留言祝福互动卡片 */
.interactive-card {
  padding: 30rpx 28rpx;
  margin-bottom: 24rpx;
  background: var(--card-bg, rgba(16, 34, 53, 0.75));
  border: 1px solid var(--card-border, #31566c);
  border-radius: 20rpx;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--accent, #6ae3ef);
}

.section-sub {
  font-size: 22rpx;
  opacity: 0.65;
}

.quick-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.tag-item {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 12rpx;
  color: var(--gold, #ffd700);
  transition: all 0.2s ease;
}

.tag-item:active {
  background: var(--accent, #6ae3ef);
  color: #000;
}

.blessing-textarea {
  width: 100%;
  height: 150rpx;
  background: rgba(0, 0, 0, 0.25);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
}

.action-footer {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.heart-btn {
  flex: 0 0 200rpx;
  background: rgba(255, 75, 110, 0.15);
  border: 1px solid rgba(255, 75, 110, 0.6);
  color: #ff4b6e;
  border-radius: 40rpx;
  font-size: 24rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
}

.heart-btn.pulse {
  transform: scale(1.15);
}

.heart-icon {
  font-size: 30rpx;
  margin-right: 6rpx;
}

.likes-badge {
  font-size: 22rpx;
  margin-left: 6rpx;
  opacity: 0.9;
}

.send-msg-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  padding: 0;
  margin: 0;
}

/* 中奖结果卡片 */
.result-card {
  padding: 30rpx 24rpx;
  text-align: center;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.3);
}

.winner-box {
  background: rgba(255, 215, 0, 0.12);
  border: 1px solid #ffd700;
}

.trophy-icon {
  font-size: 70rpx;
  margin-bottom: 12rpx;
}

.winner-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffd700;
  margin-bottom: 12rpx;
}

.prize-tag {
  display: inline-block;
  font-size: 28rpx;
  font-weight: bold;
  background: #ffd700;
  color: #3b0206;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
}

.winner-tip {
  font-size: 22rpx;
  opacity: 0.8;
}

.lottery-done-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.lottery-done-tip {
  font-size: 22rpx;
  opacity: 0.7;
}

.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  color: var(--accent, #6ae3ef);
}

.empty-tip {
  font-size: 26rpx;
  line-height: 1.6;
  opacity: 0.8;
  margin-bottom: 40rpx;
}

.scan-btn {
  width: 100%;
}
