
# 后台已保存字段 > 环境变量 > 默认值；空白密钥保存时保留现值。
SITE_NAME=瞎折腾摇奖吧
ALLOW_PASSWORD_REGISTER=true
ENABLE_EMAIL_REGISTER=false
ENABLE_PHONE_REGISTER=false
ENABLE_WECHAT_LOGIN=false
ENABLE_DINGTALK_LOGIN=false
ENABLE_TELEGRAM_LOGIN=false
UNVERIFIED_ACTIVITY_HOURS=24
UNVERIFIED_RETENTION_HOURS=24
# 时限为1–168整数小时。活动期限从创建起算；保留期限从揭晓结束起算。
# CF 必须自行生成随机 SETUP_KEY 并使用 wrangler secret put SETUP_KEY 设置，无默认值。
# 本地留空时生成随机密钥，保存在 DATA_DIR/owner-setup-key。
SETUP_KEY=
# 以下发送服务凭证在 CF 用 Secrets；URL 必须指向可信的验证码发送服务。
EMAIL_SENDER_URL=
EMAIL_SENDER_TOKEN=
EMAIL_SENDER_FROM=
PHONE_SENDER_URL=
PHONE_SENDER_TOKEN=
PHONE_SENDER_FROM=
YOUTUBE_API_KEY=
# 站点登录与活动签到的后台配置独立；以下同名 env 仅提供共享默认值。
# 微信网站应用登录和公众号签到通常不能共用同一应用，请在各自后台分别配置。
# APP_SECRET / CLIENT_SECRET / BOT_TOKEN / WEBHOOK_SECRET 在 CF 应作为 Secrets 设置。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
SIGNIN_BASE_URL=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
